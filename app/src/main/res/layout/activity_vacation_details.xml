<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.VacationDetails">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="412dp"
        android:layout_height="250dp"
        android:background="#33ddff"
        app:layout_constraintLeft_toLeftOf="parent"

        app:layout_constraintTop_toTopOf="parent">

        <!-- Use the following for form entry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Wrapping the TextView and EditText within the LinearLayout
            allows elements to sit beside each other -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="193dp"
                    android:layout_height="50dp"
                    android:padding="15dp"
                    android:text="Vacation Title"></TextView>
                <!-- The id in EditText allows us to reference the text entered here in the future -->
                <EditText
                    android:id="@+id/vacayTitle2"
                    android:hint="Title your vacation"
                    android:layout_width="220dp"
                    android:layout_height="50dp"></EditText>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="193dp"
                    android:layout_height="50dp"
                    android:padding="15dp"
                    android:text="Accommodations"></TextView>
                <!-- The id in EditText allows us to reference the text entered here in the future -->
                <EditText
                    android:id="@+id/vacayStay"
                    android:hint="Hotel name"
                    android:layout_width="220dp"
                    android:layout_height="50dp"></EditText>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="193dp"
                    android:layout_height="50dp"
                    android:padding="15dp"
                    android:text="Start Date"></TextView>
                <!-- The id in EditText allows us to reference the text entered here in the future -->
                <EditText
                    android:id="@+id/vacayStart"
                    android:hint="MM/dd/yy"
                    android:layout_width="220dp"
                    android:layout_height="50dp"></EditText>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="193dp"
                    android:layout_height="50dp"
                    android:padding="15dp"
                    android:text="End Date"></TextView>
                <!-- The id in EditText allows us to reference the text entered here in the future -->
                <EditText
                    android:id="@+id/vacayEnd"
                    android:hint="MM/dd/yy"
                    android:layout_width="220dp"
                    android:layout_height="50dp"></EditText>
            </LinearLayout>


        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="410dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/scrollView"
        app:layout_constraintLeft_toLeftOf="@id/scrollView"
        android:id="@+id/excursionHeader">

    <TextView

        android:layout_width="410dp"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:gravity="center"
        android:background="@drawable/back"
        android:text="Excursion Options:"></TextView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toLeftOf="parent"

        app:srcCompat="@drawable/baseline_add_24" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/excursionRecyclerView"
        android:layout_width="409dp"
        android:layout_height="370dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/excursionHeader"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
