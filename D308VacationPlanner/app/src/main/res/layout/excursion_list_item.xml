<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- FIX ME: Still has demo constraints. Add your own -->
    <TextView
        android:id="@+id/excurTitle1"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Excursion Title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <TextView
        android:id="@+id/excurVacay"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Associated Vacation"
        app:layout_constraintLeft_toRightOf="@id/excurTitle1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/excurDate2"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:text="Date"
        android:gravity="center"
        tools:layout_editor_absoluteX="151dp"
        tools:layout_editor_absoluteY="296dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/excurVacay"/>
</androidx.constraintlayout.widget.ConstraintLayout>